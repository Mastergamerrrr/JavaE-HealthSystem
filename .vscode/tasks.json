{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile",
            "type": "shell",
            "command": "javac",
            "args": [
                "-d", "${workspaceFolder}/bin",
                "-cp", "${workspaceFolder}/lib/*",
                "${workspaceFolder}/src/com/example/QRScanner.java"
            ],
            "group": "build"
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "${workspaceFolder}/bin;${workspaceFolder}/lib/*",
                "com.example.QRScanner"
            ],
            "dependsOn": ["Compile"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}